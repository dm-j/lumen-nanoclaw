#!/bin/sh
# tasks_finish — mark a task done via mtn. Matches by title text or exact
# path against the vault. mtn fails closed on ambiguity (multiple title
# matches): it refuses and lists the candidates with their paths rather than
# guessing, so a vague title is safe, just may need a retry with the path.
case "${1:-}" in
  --help)
    cat <<'EOF'
{"description": "Mark a task as finished (done). Prefer the exact `path` field from tasks_list when you have it — unambiguous, always works. A title or substring also works if it uniquely identifies one task; an ambiguous match is rejected (never silently guessed) with the matching candidates and their paths, so retry with the path it shows you.", "inputSchema": {"type": "object", "properties": {"task": {"type": "string", "description": "A task's exact `path` (preferred) from tasks_list, or a title/substring that uniquely identifies one task."}}, "required": ["task"]}}
EOF
    exit 0 ;;
esac

set -eu
PATH="/opt/homebrew/bin:$PATH"

# See tasks_capture-host's comment: $1 is always a JSON string of the full
# tool-call args object, never the bare field value.
TASK="$(printf '%s' "${1:-}" | jq -r '.task // empty')"
if [ -z "$TASK" ]; then
  echo "tasks_finish: task title required" >&2
  exit 1
fi

mtn complete "$TASK"
