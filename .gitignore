# Dependencies
node_modules/
.npm-cache/
# pnpm content-addressable store (created when running in sandbox mode)
.pnpm-store/
# Build output
dist/

# Local data & auth
store/
data/
logs/

# Groups - per-installation state, not tracked
groups/*

# ...except mcp-shims scripts: these are capability code (like a real MCP
# server's wiring would be), not instance state — worth persisting/versioning
# the same way. A fully-ignored directory blocks descent for later
# negations, so: un-ignore each group folder for traversal, re-ignore all
# its direct children (container.json, persona, host-shims/ with real
# credentials/paths, memory, etc. stay excluded exactly as before), then
# un-ignore only the one child that should be tracked.
!groups/*/
groups/*/*
!groups/*/mcp-shims
!groups/*/mcp-shims/**

# Composer-managed CLAUDE.md artifacts (regenerated every spawn) and
# per-group memory (CLAUDE.local.md) must never be committed.
**/CLAUDE.local.md
**/.claude-shared.md
**/.claude-fragments/

# Secrets
*.keys.json
.env
.env*

# Temp files
.tmp-*

# OS
.DS_Store

# IDE
.idea/
.vscode/

# Skills system (local per-installation state)
.nanoclaw/
.memsearch/

agents-sdk-docs
.agents
AGENTS.md

# Internal working docs, never committed
docs/maintainer-guide.md
docs/drafts/
forks.md
